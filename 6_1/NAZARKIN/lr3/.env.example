# Backend
LR3_BACKEND_HOST=127.0.0.1
LR3_BACKEND_PORT=8000
LR3_RUNTIME_DIR=./runtime
# Optional shared secret for /tools/* endpoints
# LR3_INTERNAL_TOKEN=change-me

# LLM gateway
LR3_LLM_HOST=127.0.0.1
LR3_LLM_PORT=8010
LR3_BACKEND_URL=http://127.0.0.1:8000

# OpenAI-compatible provider.  The default is OpenCode's public inference
# endpoint.  Replace with any compatible provider and key if needed.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://opencode.ai/inference/openai/v1
LLM_API_KEY=public
LLM_MODEL=deepseek-v4.1-flash-free
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=70
LLM_MAX_TOOL_STEPS=6
# Keep the demo alive when the free provider quota is exhausted:
LLM_FALLBACK_MOCK=1

# Set to 1 to run entirely without an external LLM:
# LLM_PROVIDER=mock
