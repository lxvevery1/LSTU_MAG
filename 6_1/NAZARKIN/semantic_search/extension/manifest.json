{
  "manifest_version": 3,
  "name": "WSB Semantic Search",
  "version": "1.0.0",
  "description": "Семантический поиск по постам r/WallStreetBets через локальный HTTP API.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WSB Semantic Search — настройки"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wsb-semantic-search@localhost",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*"
      ]
    }
  ]
}
