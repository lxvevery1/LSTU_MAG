# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Large generated artifacts (rebuild with make data / make train)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
models/*
!models/.gitkeep

# Local secrets and env files
.env
.env.*
*.pem

# OS noise
.DS_Store
*.log

# Local recovery snapshot: preserve large partial checkpoints and raw tmp logs
# on disk, but do not stage them in git.
experiment_state/partial_runs/*
!experiment_state/partial_runs/README.md
experiment_state/tmp_opencode_snapshot_*/
experiment_state/logs/
